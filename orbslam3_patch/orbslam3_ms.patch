+            s.nInliers[m]++;
+    }
+    s.keyFrame = (mpTracker->GetLastKeyFrameFrameId() == F.mnId);
+    s.trackingState = mpTracker->mState;
+    s.nMaps = mpAtlas->CountMaps();
+    s.mapId = mpAtlas->GetCurrentMap()->GetId();
+    s.nKeyFramesInMap = mpAtlas->KeyFramesInMap();
+    MSControl &c = MSControl::Get();
+    s.appliedFeaturesRGB = c.nFeaturesRGB;
+    s.appliedFeaturesThermal = c.thermal.empty() ? 0 : (int)c.nFeaturesThermal;
+    s.appliedMinKeyFrameInterval = c.minKeyFrameInterval;
+    s.appliedLocalBA = c.localBA;
+    s.appliedLocalBAEvery = c.localBAEvery;
+    s.appliedLoopClosureMode = c.loopClosureMode;
+    return s;
+}
