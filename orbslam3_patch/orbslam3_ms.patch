+void System::SaveTrajectoryAllMapsMS(const string &filename)
+{
+    // Same reconstruction as SaveTrajectoryTUM (relative pose to the reference keyframe, after all
+    // optimisation), but for every map of the Atlas and without moving the origin to the first keyframe.
+    ofstream f;
+    f.open(filename.c_str());
+    f << fixed;
+    list<ORB_SLAM3::KeyFrame*>::iterator lRit = mpTracker->mlpReferences.begin();
+    list<double>::iterator lT = mpTracker->mlFrameTimes.begin();
+    list<bool>::iterator lbL = mpTracker->mlbLost.begin();
+    for(list<Sophus::SE3f>::iterator lit=mpTracker->mlRelativeFramePoses.begin(),
+        lend=mpTracker->mlRelativeFramePoses.end();lit!=lend;lit++, lRit++, lT++, lbL++)
+    {
+        if(*lbL)
+            continue;
+        KeyFrame* pKF = *lRit;
+        if(!pKF)
+            continue;
+        Sophus::SE3f Trw;
+        while(pKF->isBad() && pKF->GetParent())
+        {
+            Trw = Trw * pKF->mTcp;
+            pKF = pKF->GetParent();
+        }
+        if(pKF->isBad() || !pKF->GetMap())
+            continue;
+        Trw = Trw * pKF->GetPose();
+        Sophus::SE3f Twc = ((*lit) * Trw).inverse();
+        Eigen::Vector3f twc = Twc.translation();
+        Eigen::Quaternionf q = Twc.unit_quaternion();
+        f << setprecision(6) << *lT << " " << setprecision(9) << twc(0) << " " << twc(1) << " " << twc(2) << " "
+          << q.x() << " " << q.y() << " " << q.z() << " " << q.w() << " " << pKF->GetMap()->GetId() << endl;
+    }
+    f.close();
+}
+
+MSFrameStats System::GetMSFrameStats()
+{
+    // Called from the thread that calls TrackRGBD, right after it returns.
+    MSFrameStats s;
+    const Frame &F = mpTracker->mCurrentFrame;
+    const bool bTagged = F.mDescriptors.cols > MS_TAG_COLUMN;
+    for(int i = 0; i < F.N && i < F.mDescriptors.rows; i++)
+    {
