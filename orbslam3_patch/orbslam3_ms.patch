diff --git a/include/MSControl.h b/include/MSControl.h
new file mode 100644
index 0000000..67c6563
--- /dev/null
+++ b/include/MSControl.h
@@ -0,0 +1,70 @@
+/**
+* Multispectral / energy-aware control interface added to ORB-SLAM3 (compiled when MS_SLAM is defined).
+*
+* A single process-wide control block that the caller sets before every System::TrackRGBD call and that
+* Tracking, LocalMapping and LoopClosing read. It carries the thermal image of the current frame and the
+* run-time switches of the energy-aware scheduler. See orbslam3_patch/ORBSLAM3_CHANGES.md.
+*/
+
+#ifndef MSCONTROL_H
+#define MSCONTROL_H
+
+#include <atomic>
+#include <opencv2/core/core.hpp>
+
+namespace ORB_SLAM3
+{
+
+enum MSModality { MS_RGB = 0, MS_THERMAL = 1 };
+
+// Descriptors are stored as 33 bytes: the 32-byte ORB descriptor followed by the modality tag.
+const int MS_DESCRIPTOR_BYTES = 32;
+const int MS_TAG_COLUMN = 32;
+
+enum MSLoopClosureMode { MS_LC_FULL = 0, MS_LC_REDUCED = 1, MS_LC_OFF = 2 };
+
+// In "reduced" mode place recognition is attempted for one keyframe in this many,
+// and no global bundle adjustment is launched after a loop correction.
+const int MS_LC_REDUCED_EVERY = 3;
+
+struct MSControl
+{
+    // ORB feature budget of each modality for the next frame (0 = modality not used).
+    std::atomic<int> nFeaturesRGB{-1};      // -1: keep the value from the settings file
+    std::atomic<int> nFeaturesThermal{0};
+    // Minimum number of frames between keyframes (0 = ORB-SLAM3's own policy only).
+    std::atomic<int> minKeyFrameInterval{0};
+    std::atomic<bool> localBA{true};
+    // Run local bundle adjustment for one keyframe in this many (1 = every keyframe).
+    std::atomic<int> localBAEvery{1};
+    std::atomic<int> loopClosureMode{MS_LC_FULL};
+
+    // Thermal image of the next frame: 8-bit, single channel, same size and intrinsics as the RGB image.
+    // Written and read by the tracking thread only.
+    cv::Mat thermal;
+
+    static MSControl& Get();
+};
+
+// Per-frame feedback for the controller (filled by System::GetMSFrameStats).
+struct MSFrameStats
+{
+    int nKeys[2] = {0, 0};        // extracted keypoints per modality
+    int nInliers[2] = {0, 0};     // keypoints matched to a map point and not rejected as outliers
+    bool keyFrame = false;        // a keyframe was created from this frame
+    int trackingState = 0;        // Tracking::eTrackingState
+    int nMaps = 0;
+    long unsigned mapId = 0;      // Atlas id of the map this frame was tracked in
+    long unsigned nKeyFramesInMap = 0;
+    // control values that were applied to this frame
+    int appliedFeaturesRGB = 0;
+    int appliedFeaturesThermal = 0;
+    int appliedMinKeyFrameInterval = 0;
+    bool appliedLocalBA = true;
+    int appliedLocalBAEvery = 1;
+    int appliedLoopClosureMode = 0;
+};
+
+} // namespace ORB_SLAM3
+
+#endif // MSCONTROL_H
