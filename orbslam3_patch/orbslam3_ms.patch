+void Frame::ExtractORBMS(const cv::Mat &imGray)
+{
+    MSControl &ctrl = MSControl::Get();
+    vector<int> vLapping = {0,0};
+
+    vector<cv::KeyPoint> vKeys[2];
+    cv::Mat descriptors[2];
+
+    int nRGB = ctrl.nFeaturesRGB;
+    if(nRGB < 0)
+        nRGB = mpORBextractorLeft->GetNFeatures();
+    const int nThermal = ctrl.thermal.empty() ? 0 : (int)ctrl.nFeaturesThermal;
+
+    if(nRGB > 0)
+    {
+        mpORBextractorLeft->SetNFeatures(nRGB);
+        monoLeft = (*mpORBextractorLeft)(imGray,cv::Mat(),vKeys[MS_RGB],descriptors[MS_RGB],vLapping);
+    }
+    if(nThermal > 0)
+    {
+        // one thermal extractor per process, same pyramid and thresholds as the RGB extractor
+        static ORBextractor* pThermalExtractor = mpORBextractorLeft->Clone();
+        pThermalExtractor->SetNFeatures(nThermal);
+        (*pThermalExtractor)(ctrl.thermal,cv::Mat(),vKeys[MS_THERMAL],descriptors[MS_THERMAL],vLapping);
+    }
+
+    const int nTotal = vKeys[MS_RGB].size() + vKeys[MS_THERMAL].size();
+    mvKeys.clear();
+    mvKeys.reserve(nTotal);
+    mDescriptors = cv::Mat(nTotal, MS_DESCRIPTOR_BYTES + 1, CV_8U);
+    int row = 0;
+    for(int m = 0; m < 2; m++)
+    {
+        for(size_t i = 0; i < vKeys[m].size(); i++, row++)
+        {
+            mvKeys.push_back(vKeys[m][i]);
+            memcpy(mDescriptors.ptr<uchar>(row), descriptors[m].ptr<uchar>(i), MS_DESCRIPTOR_BYTES);
+            mDescriptors.at<uchar>(row, MS_TAG_COLUMN) = (uchar)m;
+        }
+    }
+    monoLeft = nTotal;
+}
+
 bool Frame::isSet() const {
     return mbIsSet;
 }
